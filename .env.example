# From your Supabase project: Project Settings → API (or the "Connect" dialog).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: the public URL of the site, used in confirmation emails.
# Defaults to the request's origin.
# NEXT_PUBLIC_SITE_URL=https://justrecipe.example.com

# --- Failure queue (optional) ---
# Links the app can't read are queued and analyzed by Grok once a day, which
# files a GitHub issue with a suggested parser fix. Leave these unset to turn it off.
# Server-only secret key: Supabase Project Settings → API keys → Secret keys.
# SUPABASE_SECRET_KEY=sb_secret_xxx
# xAI API key for Grok: https://console.x.ai
# XAI_API_KEY=xai-xxx
# XAI_MODEL=grok-4
# Fine-grained GitHub token with "Issues: read and write" on this repository.
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_REPO=cwood1009/Justrecipe
# Any long random string; Vercel Cron sends it so only Vercel can run the job.
# CRON_SECRET=
